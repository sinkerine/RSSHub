    "description": "Get one X post by author handle and post ID, plus the conversation posts X returns with it (ancestors and replies from a single page; none on the developer-API backend). Every call is a fresh read. Requires TWITTER_AUTH_TOKEN (web backend) or TWITTER_CONSUMER_KEY + TWITTER_CONSUMER_SECRET. TWITTER_THIRD_PARTY_API alone is not enough.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "description": "Maximum conversation posts in \`thread\`, 1–20. Default 20. The requested post is always returned.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "tweetId": {
          "description": "Numeric post ID from \`x.com/<user>/status/<tweetId>\`.",
          "pattern": "^[0-9]{1,20}$",
          "type": "string",
        },
        "user": {
          "description": "Author handle without @ or \`+numericId\`, taken from \`x.com/<user>/status/<tweetId>\`.",
          "pattern": "^(?:@?[A-Za-z0-9_]{1,15}|\\+[0-9]{1,20})$",
          "type": "string",
        },
      },
      "required": [
        "user",
        "tweetId",
      ],
      "type": "object",
    },
