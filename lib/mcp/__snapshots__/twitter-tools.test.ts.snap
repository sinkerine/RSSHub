          "maxLength": 4096,
          "pattern": "^v1\\.[A-Za-z0-9_-]+$",
          "type": "string",
        },
        "includeReplies": {
          "default": false,
          "description": "Include the user's replies (X's 'Posts & replies' timeline). Default false returns only root posts.",
