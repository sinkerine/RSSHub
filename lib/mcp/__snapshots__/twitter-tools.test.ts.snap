          "maxLength": 4096,
          "pattern": "^v1\\.[A-Za-z0-9_-]+$",
          "type": "string",
        },
        "limit": {
          "default": 20,
          "description": "Maximum posts to return, 1–20. Default 20.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
