          "maxLength": 4096,
          "pattern": "^v1\\.[A-Za-z0-9_-]+$",
          "type": "string",
        },
        "includeReplies": {
          "default": false,
          "description": "Include the user's replies (X's 'Posts & replies' timeline). Default false returns only root posts.",
          "type": "boolean",
        },
        "includeRetweets": {
          "default": true,
          "description": "Include reposts. Default true. The filter is applied after fetching the single upstream page, so fewer than \`limit\` posts may be returned.",
          "type": "boolean",
        },
        "limit": {
          "default": 20,
          "description": "Maximum posts to return, 1–20. Default 20.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "user": {
          "description": "X handle without @ (e.g. \`DIYgod\`; a leading @ is removed), or \`+\` followed by the numeric user ID (e.g. \`+44196397\`).",
